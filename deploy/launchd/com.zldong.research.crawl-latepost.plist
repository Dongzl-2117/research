<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 每天 08:30 和 20:30（香港时间，launchd 用本机时区）晚点LatePost 增量抓取并入库。
     只查极致了最新一页，不翻历史。由 scripts/install-launchd.sh 安装。 -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zldong.research.crawl-latepost</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/crawl-latepost.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>REPO</key>
    <string>__REPO__</string>
  </dict>
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>8</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>20</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
  </array>
  <key>StandardOutPath</key>
  <string>__LOGS__/crawl-latepost.log</string>
  <key>StandardErrorPath</key>
  <string>__LOGS__/crawl-latepost.err.log</string>
</dict>
</plist>
