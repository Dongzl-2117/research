<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 每小时从 AIHOT 只读增量导入最近 14 天的白名单文章。由 scripts/install-launchd.sh 安装。 -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zldong.research.ingest-aihot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/ingest-aihot.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>REPO</key>
    <string>__REPO__</string>
    <key>DAYS</key>
    <string>14</string>
  </dict>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>StandardOutPath</key>
  <string>__LOGS__/ingest-aihot.log</string>
  <key>StandardErrorPath</key>
  <string>__LOGS__/ingest-aihot.err.log</string>
</dict>
</plist>
