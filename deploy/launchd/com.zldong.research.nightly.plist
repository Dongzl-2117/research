<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 每晚 00:37 补外链图片、观点、摘要、论点（可选图片文字）。由 scripts/install-launchd.sh 安装。 -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zldong.research.nightly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/nightly.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>REPO</key>
    <string>__REPO__</string>
    <key>NIGHTLY_OCR</key>
    <string>__NIGHTLY_OCR__</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>0</integer>
    <key>Minute</key>
    <integer>37</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__LOGS__/nightly.log</string>
  <key>StandardErrorPath</key>
  <string>__LOGS__/nightly.err.log</string>
</dict>
</plist>
