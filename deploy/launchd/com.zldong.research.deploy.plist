<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 每 10 分钟看一次 main，有 CI 通过的新提交就拉代码、重建并重启（scripts/deploy.sh）。装好时先跑一次。由 scripts/install-launchd.sh 安装。 -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zldong.research.deploy</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/deploy.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>REPO</key>
    <string>__REPO__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>600</integer>
  <key>StandardOutPath</key>
  <string>__LOGS__/deploy.log</string>
  <key>StandardErrorPath</key>
  <string>__LOGS__/deploy.err.log</string>
</dict>
</plist>
