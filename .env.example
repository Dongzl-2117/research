# 复制为 .env 后按本机修改。不要把真密码或付费原文提交进仓库。
# 站点域名是 investment.zldong.com。仓库名仍然是 research。

DATABASE_URL=postgresql://research:research@127.0.0.1:5432/research
DATA_DIR=./data
PUBLIC_BASE_URL=https://investment.zldong.com
BIND_HOST=127.0.0.1
BIND_PORT=8088
# 只在容器内、且 docker 把端口发布到 127.0.0.1 时才设为 1。
ALLOW_NONLOCAL_BIND=0
SOURCES_FILE=./config/sources.yaml
# 持仓和观察名单：首页「持仓近况」、公司列表置顶都读它。
PORTFOLIO_FILE=./config/portfolio.yaml
DISPLAY_TIMEZONE=Asia/Shanghai

# 写入示例文章时才需要。生产环境不要打开。
ALLOW_SAMPLE_SEED=0

# —— LLM（译制、问库、摘要、观点、论点）——
# 默认 DeepSeek：deepseek-flash，thinking 打开、reasoning_effort=max，输出至少 393216，上下文 1M。
# 缺 DEEPSEEK_API_KEY 时直接报错，不会悄悄退回 Grok。
# 想换回 Grok OAuth：设 RESEARCH_LLM_PROVIDER=grok，见下面 Grok 那一段。
RESEARCH_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# 可选：只改地址、模型或推理强度。模型名字里带 flash 会被拒绝（站内不用轻量档）。
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_REASONING_EFFORT=max
# 可选：把输出预算抬得比 393216 更高。设得更低也会被抬回 393216。
# DEEPSEEK_MAX_TOKENS=393216
# LLM_LONG_TIMEOUT_MS=1500000
# 同时在跑的 LLM 请求上限（问库分批、摘要、观点、论点加起来）。
# RESEARCH_LLM_CONCURRENCY=3

# —— Grok OAuth（可选，不再是默认）——
# 设 RESEARCH_LLM_PROVIDER=grok 才走这里。登录一次（device-code，在自己的浏览器里授权）：
#   docker compose exec app research-xai-login login
# research-xai-login status 检查这一份文件。
# 没有这份登录就报错，不使用 XAI_API_KEY。
# 强度写死在 researchlib/grok.py：grok-4.7、reasoning_effort=xhigh、
# 输出至少 128000、上下文 500000，不发 fast。
# RESEARCH_LLM_PROVIDER=grok
# XAI_OAUTH_TOKEN_PATH=/data/secrets/xai-oauth.json
# XAI_OAUTH_FILE_UID=0
# XAI_OAUTH_FILE_GID=0
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MAX_TOKENS=128000

# 公众号定时抓取用的极致了（dajiala）key：方伟公众号（宿主机上的 scripts/crawl-fangwei-mp.sh）和
# 孤独进化体（容器里的 research-crawl-wechat，docker compose 透传）共用。按次收费，查一次列表约 0.14 元。
# DAJIALA_KEY=

# 首页断更提示。只看最近三天确实做过定时导入（定时抓取脚本）的来源，只手动导归档的来源不会提示。
# 不想要设 0。
# RESEARCH_STALE_BANNER=1

# 打开公司页时后台自动补论点。默认关；需要时设 1。
# RESEARCH_THESES_AUTO=0

# —— 语义检索（可选）——
# 向量服务走 OpenAI 兼容的 /embeddings。推荐在 macOS 本机（不在 Docker 里）装 Ollama，走苹果芯片 GPU：
#   brew install ollama && brew services start ollama && ollama pull bge-m3
# 容器里访问本机用 host.docker.internal。留空则只用关键词检索。
# 换成云端向量 API 时填它的地址、模型和 key；维度要是 1024（和 bge-m3 一样）。
# EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_API_KEY=
