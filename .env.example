# 复制为 .env 后按本机修改。不要把真密码或付费原文提交进仓库。
# 站点域名是 investment.zldong.com。仓库名仍然是 research。

DATABASE_URL=postgresql://research:research@127.0.0.1:5432/research
DATA_DIR=./data
PUBLIC_BASE_URL=https://investment.zldong.com
BIND_HOST=127.0.0.1
BIND_PORT=8088
# 只在容器内、且 docker 把端口发布到 127.0.0.1 时才设为 1。
ALLOW_NONLOCAL_BIND=0
SOURCES_FILE=./config/sources.yaml
# 持仓和观察名单：首页「持仓近况」、公司列表置顶都读它。
PORTFOLIO_FILE=./config/portfolio.yaml
AIHOT_MAP_FILE=./config/aihot_import.yaml
DISPLAY_TIMEZONE=Asia/Shanghai

# 可选：只读导入 AIHOT 的 articles 表。留空则不连接。
AIHOT_DATABASE_URL=

# 写入示例文章时才需要。生产环境不要打开。
ALLOW_SAMPLE_SEED=0

# —— Grok（译制、问库、摘要、观点、论点）。与 AIHOT 共用同一份 xAI OAuth ——
# Docker 默认挂载外部卷 aihot_data → /aihot-data，token 路径如下。
# 登录在 AIHOT 侧做一次即可：
#   cd ~/aihot && docker compose exec api node scripts/xai-login.ts login
# research-xai-login status 检查这一份文件。
# 没有这份登录就报错，不使用 XAI_API_KEY，也不接别的模型。
# 强度写死在 researchlib/grok.py，译制和问库/摘要同一口径：
#   grok-4.7、reasoning_effort=xhigh、输出至少 128000、上下文 500000，不发 fast。
# 摘要只通过 research-digest 手动跑，启动和部署不会自动跑全库。
# XAI_OAUTH_TOKEN_PATH=/aihot-data/secrets/xai-oauth.json
# XAI_OAUTH_FILE_UID=1000
# XAI_OAUTH_FILE_GID=1000
# XAI_BASE_URL=https://api.x.ai/v1
# 可选：把输出预算抬得比 128000 更高。设得更低也会被抬回 128000。
# XAI_MAX_TOKENS=128000
# LLM_LONG_TIMEOUT_MS=1500000
# 同时在跑的 Grok 请求上限（问库分批、摘要、观点、论点加起来）。
# RESEARCH_LLM_CONCURRENCY=3

# 首页断更提示。只看最近三天确实做过定时导入（AIHOT）的来源，AIHOT 抓取停着、只手动导归档时不会提示。
# 不想要设 0。
# RESEARCH_STALE_BANNER=1

# 打开公司页时后台自动补论点。默认关；需要时设 1。
# RESEARCH_THESES_AUTO=0
