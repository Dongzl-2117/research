# 复制为 .env 后按本机修改。不要把真密码或付费原文提交进仓库。
# 站点域名是 investment.zldong.com。仓库名仍然是 research。

DATABASE_URL=postgresql://research:research@127.0.0.1:5432/research
DATA_DIR=./data
PUBLIC_BASE_URL=https://investment.zldong.com
BIND_HOST=127.0.0.1
BIND_PORT=8088
# 只在容器内、且 docker 把端口发布到 127.0.0.1 时才设为 1。
ALLOW_NONLOCAL_BIND=0
SOURCES_FILE=./config/sources.yaml
AIHOT_MAP_FILE=./config/aihot_import.yaml
DISPLAY_TIMEZONE=Asia/Shanghai

# 可选：只读导入 AIHOT 的 articles 表。留空则不连接。
AIHOT_DATABASE_URL=

# 写入示例文章时才需要。生产环境不要打开。
ALLOW_SAMPLE_SEED=0

# —— 站内 Grok 译制（xAI OAuth）——
# research 自有 refresh token，默认写在 $DATA_DIR/secrets/xai-oauth.json（权限 600）。
# 不要和 AIHOT / Hermes 共用同一文件。先：research-xai-login login
# 模型固定 grok-4.7，推理 xhigh，上下文 500K，不用 fast。
# XAI_OAUTH_TOKEN_PATH=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MAX_TOKENS=128000
# LLM_LONG_TIMEOUT_MS=1500000
